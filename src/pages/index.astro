---
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import { SITE } from '../data/site';
import { FIELDS, FIELD_KEYS } from '../data/fields';
import { getArticles } from '../lib/articles';

const articles = await getArticles();
const latest = articles.slice(0, 6);
const counts = Object.fromEntries(FIELD_KEYS.map((k) => [k, articles.filter((a) => a.data.field === k).length]));
---
<Base>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{SITE.nameEn}</p>
      <h1>情報は、どう運ばれ、<br />どう処理されるのか。</h1>
      <p class="lead">
        インターネットのパケットも、細胞の中の DNA も、量子コンピュータの量子ビットも、突き詰めれば「情報を運び、処理する仕組み」です。
        {SITE.name}は、数式や専門用語をできるだけ使わず、物流・図書館・工場といった身近な例え話と図解で、そのしくみを読み解きます。
      </p>
    </div>
  </section>

  <section class="container">
    <h2 class="section-title">3つの分野と、その交差点</h2>
    <ul class="fields">
      {FIELD_KEYS.map((key) => (
        <li style={`--c: ${FIELDS[key].color}`}>
          <a href={`/${key}`}>
            <span class="fname">{FIELDS[key].name}</span>
            <span class="fcount">{counts[key]}本</span>
          </a>
          <p>{FIELDS[key].lead}</p>
        </li>
      ))}
    </ul>

    <h2 class="section-title">新着記事</h2>
    <ArticleList articles={latest} />

    <p class="more"><a href="/metaphors">例え話から記事を探す（たとえ図鑑）→</a></p>
  </section>
</Base>

<style>
  .hero { padding: 3.5rem 0 2.5rem; }
  .eyebrow { margin: 0; font-size: 0.85rem; font-weight: 700; letter-spacing: 0.2em; color: var(--accent); text-transform: uppercase; }
  h1 { margin: 0.4rem 0 1rem; font-size: clamp(1.7rem, 5vw, 2.6rem); line-height: 1.4; }
  .lead { max-width: 40rem; margin: 0; color: var(--ink-soft); }
  .section-title { margin: 3rem 0 1rem; font-size: 1.25rem; }
  .fields { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); }
  .fields li { background: var(--paper); border: 1px solid var(--rule); border-top: 5px solid var(--c); border-radius: var(--radius); padding: 1rem 1.1rem; }
  .fields a { display: flex; justify-content: space-between; align-items: baseline; text-decoration: none; }
  .fname { font-weight: 800; font-size: 1.1rem; color: var(--c); }
  .fcount { font-size: 0.8rem; color: var(--ink-soft); }
  .fields p { margin: 0.4rem 0 0; font-size: 0.88rem; line-height: 1.65; color: var(--ink-soft); }
  .more { margin-top: 2rem; }
</style>
