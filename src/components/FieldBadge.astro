---
import { FIELDS, type FieldKey } from '../data/fields';
interface Props { field: FieldKey; link?: boolean }
const { field, link = true } = Astro.props;
const f = FIELDS[field];
const Tag = link ? 'a' : 'span';
---
<Tag class="badge" href={link ? `/${field}` : undefined} style={`--c: ${f.color}`}>{f.name}</Tag>

<style>
  .badge { display: inline-block; font-size: 0.75rem; font-weight: 700; line-height: 1.6; padding: 0.05rem 0.6rem; border-radius: 999px; color: var(--c); border: 1.5px solid var(--c); text-decoration: none; background: var(--paper); }
</style>
