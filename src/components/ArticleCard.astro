---
import FieldBadge from './FieldBadge.astro';
import { articleUrl, formatDate, type Article } from '../lib/articles';
interface Props { article: Article; showField?: boolean }
const { article, showField = true } = Astro.props;
const { title, description, publishedAt, draft, field } = article.data;
---
<article class="card" style={`--c: var(--c-${field})`}>
  <div class="meta">
    {showField && <FieldBadge field={field} link={false} />}
    <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
    {draft && <span class="draft">下書き</span>}
  </div>
  <h3><a href={articleUrl(article)}>{title}</a></h3>
  <p>{description}</p>
</article>

<style>
  .card { position: relative; background: var(--paper); border: 1px solid var(--rule); border-left: 4px solid var(--c); border-radius: var(--radius); padding: 1rem 1.2rem; }
  .card:hover { border-color: var(--c); }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; font-size: 0.8rem; color: var(--ink-soft); }
  h3 { margin: 0.4rem 0 0.3rem; font-size: 1.1rem; line-height: 1.5; }
  h3 a { color: var(--ink); text-decoration: none; }
  h3 a::after { content: ''; position: absolute; inset: 0; }
  p { margin: 0; font-size: 0.92rem; line-height: 1.7; color: var(--ink-soft); }
  .draft { font-weight: 700; color: var(--c-crossover); }
</style>
