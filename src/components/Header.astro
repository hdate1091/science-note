---
import { SITE } from '../data/site';
import { FIELDS, FIELD_KEYS } from '../data/fields';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <span class="name">{SITE.name}</span>
      <span class="tagline">{SITE.tagline}</span>
    </a>
    <nav aria-label="カテゴリ">
      <ul>
        {FIELD_KEYS.map((key) => (
          <li>
            <a href={`/${key}`} style={`--c: ${FIELDS[key].color}`} aria-current={path.startsWith(`/${key}`) ? 'page' : undefined}>
              {FIELDS[key].name}
            </a>
          </li>
        ))}
        <li><a href="/metaphors" aria-current={path.startsWith('/metaphors') ? 'page' : undefined}>たとえ図鑑</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { background: var(--paper); border-bottom: 1px solid var(--rule); }
  .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1.5rem; padding-top: 0.9rem; padding-bottom: 0.9rem; }
  .brand { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); line-height: 1.3; }
  .name { font-weight: 800; font-size: 1.3rem; letter-spacing: 0.06em; }
  .tagline { font-size: 0.78rem; color: var(--ink-soft); }
  ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; list-style: none; margin: 0; padding: 0; font-size: 0.92rem; }
  nav a { color: var(--ink); text-decoration: none; padding: 0.2rem 0; border-bottom: 2px solid transparent; }
  nav a:hover, nav a[aria-current='page'] { border-bottom-color: var(--c, var(--accent)); }
</style>
